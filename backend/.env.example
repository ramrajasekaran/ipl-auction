# Backend Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Connection String (Required)
# For local: mongodb://localhost:27017/ipl-auction
# For production: Use MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/ipl-auction

# Server Port
PORT=5000

# Environment
NODE_ENV=development

# CORS Origin (Required for production)
# For local: http://localhost:5173
# For production: Your Netlify frontend URL (no trailing slash)
CORS_ORIGIN=http://localhost:5173

# JWT Secret (Required - use a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT Expiry
JWT_EXPIRE=24h
REFRESH_TOKEN_EXPIRE=7d

# Session Secret (Required - use a strong random string)
SESSION_SECRET=your-super-secret-session-key-change-in-production

# Session Configuration
SESSION_MAX_AGE=86400000
SESSION_NAME=ipl_auction_sid

# Email Configuration (Optional - for password reset)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password
# EMAIL_FROM=IPL Auction <your-email@gmail.com>
